# ==============================================================================
# ESPHome Secrets Configuration Template
# ==============================================================================
# Rename this file to 'secrets.yaml' and fill in your actual credentials.
# Note: 'secrets.yaml' is already ignored by Git to protect your private data.
# ==============================================================================

# Wi-Fi Credentials
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Optional: Fallback hotspot password if Wi-Fi cannot connect
# wifi_ap_password: "FALLBACK_AP_PASSWORD"

# Optional: Home Assistant API encryption key (if encryption is enabled in dashboard)
# api_encryption_key: "GENERATE_KEY_FROM_ESPHOME_DASHBOARD"

# Optional: OTA update password
# ota_password: "OTA_UPDATE_PASSWORD"
