# Configurazione credenziali per ESPHome
# Rinomina questo file in 'secrets.yaml' e inserisci i tuoi valori reali

wifi_ssid: "IL_TUO_WIFI_SSID"
wifi_password: "LA_TUA_WIFI_PASSWORD"

# Opzionale: fallback hotspot AP se il Wi-Fi non e' raggiungibile
# wifi_ap_password: "PASSWORD_HOTSPOT_EMERGENZA"

# Opzionale: chiave crittografica API Home Assistant (se abilitata)
# api_encryption_key: "GENERA_UNA_CHIAVE_DA_ESPHOME_DASHBOARD"

# Opzionale: password per aggiornamenti OTA
# ota_password: "PASSWORD_AGGIORNAMENTO_OTA"

